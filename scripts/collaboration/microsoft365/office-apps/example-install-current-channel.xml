<Configuration>
  <!--
    M365 Apps - Current Channel (Fastest Updates)

    This configuration installs M365 Apps with:
    - Current Channel (formerly Monthly Channel)
    - Latest features as soon as they're released
    - 64-bit installation
    - All Office apps
    - Best for early adopters and users who want newest features

    Channel GUID: 492350f6-3a01-4f97-b9c0-c7c6ddf67d60
    Update frequency: Multiple times per month (as released)

    Use case: Power users, pilot groups, organizations wanting cutting-edge features

    Usage: Place this file at C:\AVD\M365Apps\install.xml
  -->

  <Add OfficeClientEdition="64" Channel="Current" SourcePath="C:\AVD\M365Apps\OfficeUpdates">
    <Product ID="O365ProPlusRetail">
      <Language ID="en-us" />
      <Language ID="en-gb" />

      <!-- Include all apps by default -->
      <!-- Uncomment to exclude specific apps -->
      <!-- <ExcludeApp ID="Groove" /> --> <!-- OneDrive for Business -->
      <!-- <ExcludeApp ID="Lync" /> --> <!-- Skype for Business / Teams -->
      <!-- <ExcludeApp ID="Access" /> -->
      <!-- <ExcludeApp ID="Publisher" /> -->
      <!-- <ExcludeApp ID="OneNote" /> -->
    </Product>
  </Add>

  <!-- Remove any old MSI-based Office installations -->
  <RemoveMSI />

  <!-- Display settings -->
  <Display Level="Full" AcceptEULA="TRUE" />

  <!-- Logging -->
  <Logging Level="Standard" Path="C:\AVD\M365Apps\Logs" />

  <!-- Automatic updates configuration -->
  <Updates Enabled="TRUE" Channel="Current" />

  <!-- Property settings -->
  <Property Name="AUTOACTIVATE" Value="1" />
  <Property Name="FORCEAPPSHUTDOWN" Value="TRUE" />
  <Property Name="SharedComputerLicensing" Value="0" />
  <Property Name="PinIconsToTaskbar" Value="TRUE" />
</Configuration>
