<Configuration>
  <!--
    M365 Apps - Monthly Enterprise Channel (Recommended for most organizations)

    This configuration installs M365 Apps with:
    - Monthly Enterprise Channel (validated monthly updates)
    - 64-bit installation (recommended for modern systems)
    - All core Office apps (Word, Excel, PowerPoint, Outlook, OneNote, Publisher, Access)
    - Removes existing MSI Office versions
    - Accepts EULA automatically
    - Displays installation progress

    Channel GUID: 64256afe-f5d9-4f86-8936-8840a6a4f5be
    Update frequency: Monthly (validated for enterprise stability)

    Usage: Place this file at C:\AVD\M365Apps\install.xml
  -->

  <Add OfficeClientEdition="64" Channel="MonthlyEnterprise" SourcePath="C:\AVD\M365Apps\OfficeUpdates">
    <Product ID="O365ProPlusRetail">
      <Language ID="en-us" />
      <Language ID="en-gb" />

      <!-- ExcludeApp: Uncomment apps you don't want to install -->
      <!-- <ExcludeApp ID="Groove" /> --> <!-- OneDrive for Business -->
      <!-- <ExcludeApp ID="Lync" /> --> <!-- Skype for Business / Teams -->
      <!-- <ExcludeApp ID="Access" /> -->
      <!-- <ExcludeApp ID="Publisher" /> -->
    </Product>
  </Add>

  <!-- Remove any old MSI-based Office installations -->
  <RemoveMSI />

  <!-- Display settings -->
  <Display Level="Full" AcceptEULA="TRUE" />

  <!-- Logging -->
  <Logging Level="Standard" Path="C:\AVD\M365Apps\Logs" />

  <!-- Automatic updates configuration -->
  <Updates Enabled="TRUE" Channel="MonthlyEnterprise" />

  <!-- Application preferences -->
  <AppSettings>
    <User Key="software\microsoft\office\16.0\excel\options" Name="defaultformat" Value="51" Type="REG_DWORD" App="excel16" Id="L_SaveExcelfilesas" />
    <User Key="software\microsoft\office\16.0\powerpoint\options" Name="defaultformat" Value="27" Type="REG_DWORD" App="ppt16" Id="L_SavePowerPointfilesas" />
    <User Key="software\microsoft\office\16.0\word\options" Name="defaultformat" Value="" Type="REG_SZ" App="word16" Id="L_SaveWordfilesas" />
  </AppSettings>

  <!-- Property settings -->
  <Property Name="AUTOACTIVATE" Value="1" />
  <Property Name="FORCEAPPSHUTDOWN" Value="TRUE" />
  <Property Name="SharedComputerLicensing" Value="0" />
  <Property Name="PinIconsToTaskbar" Value="FALSE" />
</Configuration>
