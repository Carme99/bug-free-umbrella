# EditorConfig is awesome: https://EditorConfig.org

# Top-most EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

# PowerShell files (.ps1, .psm1, .psd1)
[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4
end_of_line = crlf  # Windows line endings for PowerShell compatibility
max_line_length = 120
trim_trailing_whitespace = true
insert_final_newline = true

# PowerShell Script Analyzer settings file
[*.psd1]
indent_style = space
indent_size = 4

# PowerShell XML files (CLIXML, format files, etc.)
[*.ps1xml]
indent_style = space
indent_size = 2
end_of_line = crlf

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = off  # Allow long lines in markdown (for links)

# YAML files (GitHub Actions, configs)
[*.{yml,yaml}]
indent_style = space
indent_size = 2
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# JSON files
[*.json]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true

# Batch files (Windows)
[*.{bat,cmd}]
indent_style = space
indent_size = 4
end_of_line = crlf

# Shell scripts (Unix)
[*.sh]
indent_style = space
indent_size = 2
end_of_line = lf

# Git config files
[.gitattributes]
end_of_line = lf
[.gitignore]
end_of_line = lf

# Configuration files
[*.{config,conf}]
indent_style = space
indent_size = 2

# Documentation
[{README,CHANGELOG,CONTRIBUTING,SECURITY,LICENSE,SUPPORT,CODE_OF_CONDUCT,GOVERNANCE}]
indent_style = space
indent_size = 2
end_of_line = lf
insert_final_newline = true

# Visual Studio Code settings
[.vscode/*.json]
indent_style = space
indent_size = 4

# Makefiles (require tabs)
[Makefile]
indent_style = tab
